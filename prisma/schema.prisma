generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LocationType {
  VILLAGE
  WARD
  BLOCK
}

enum ReportSource {
  WHATSAPP
  IVR
  DASHBOARD
  HEALTH_WORKER
  SIMULATION
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum WaterSourceType {
  HAND_PUMP
  TUBE_WELL
  POND
  MUNICIPAL_TAP
  TANKER
  PRIVATE_WELL
}

enum WaterSourceStatus {
  NORMAL
  WATCH
  SUSPECTED
  CONTAMINATED
}

enum WarningLevel {
  NORMAL
  WATCH
  EARLY_WARNING
  OUTBREAK
}

enum AlertPriority {
  P0
  P1
  P2
  P3
}

enum SampleMethod {
  FIELD_TEST
  LAB
  SENSOR
  DEMO
  SIMULATION
}

model Location {
  id                 String                @id @default(cuid())
  name               String
  district           String
  state              String                @default("West Bengal")
  type               LocationType
  latitude           Decimal               @db.Decimal(9, 6)
  longitude          Decimal               @db.Decimal(9, 6)
  population         Int
  households         Int
  baselineDailyCases Decimal               @default(1.4) @db.Decimal(6, 2)
  vulnerabilityIndex Decimal               @default(0.35) @db.Decimal(4, 2)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  reports            SymptomReport[]
  rainfall           RainfallObservation[]
  riskScores         RiskScore[]
  alerts             Alert[]
  waterSources       WaterSource[]

  @@index([district, type])
}

model WaterSource {
  id             String            @id @default(cuid())
  locationId     String
  name           String
  type           WaterSourceType
  status         WaterSourceStatus @default(NORMAL)
  lastInspectedAt DateTime?
  notes          String?
  location       Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reports        SymptomReport[]
  qualityObservations WaterQualityObservation[]

  @@index([locationId, status])
}

model SymptomReport {
  id               String       @id @default(cuid())
  locationId       String
  waterSourceId    String?
  source           ReportSource
  phoneHash        String?
  reporterName     String?
  ageBand          String?
  symptoms         String[]
  severity         Int          @default(2)
  onsetAt          DateTime
  reportedAt       DateTime     @default(now())
  latitude         Decimal?     @db.Decimal(9, 6)
  longitude        Decimal?     @db.Decimal(9, 6)
  notes            String?
  duplicateOfId    String?
  syndromeSignal   Json?
  location         Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  waterSource      WaterSource? @relation(fields: [waterSourceId], references: [id], onDelete: SetNull)

  @@index([locationId, reportedAt])
  @@index([phoneHash, reportedAt])
  @@index([waterSourceId])
}

model RainfallObservation {
  id          String   @id @default(cuid())
  locationId  String
  observedAt  DateTime
  rainfallMm  Decimal  @db.Decimal(7, 2)
  source      String   @default("synthetic-imd")
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, observedAt])
  @@index([locationId, observedAt])
}

model WaterQualityObservation {
  id            String           @id @default(cuid())
  waterSourceId String
  observedAt    DateTime         @default(now())
  turbidityNTU  Float?
  ph            Float?
  tds           Float?
  freeChlorine  Float?
  ecoliDetected Boolean?
  inspectionScore Int?
  sampleMethod  SampleMethod     @default(DEMO)
  confidence    Float            @default(0.5)
  notes         String?
  waterSource   WaterSource      @relation(fields: [waterSourceId], references: [id], onDelete: Cascade)

  @@index([waterSourceId, observedAt])
}

model RiskScore {
  id          String    @id @default(cuid())
  locationId  String
  score       Int
  level       RiskLevel
  windowHours Int       @default(72)
  factors     Json
  reasoning   String
  confidence  Int       @default(50)
  warningLevel WarningLevel @default(NORMAL)
  priority    AlertPriority @default(P3)
  dominantSyndrome String @default("none")
  rawMetrics  Json?
  computedAt  DateTime  @default(now())
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  alerts      Alert[]

  @@index([locationId, computedAt])
}

model Alert {
  id             String      @id @default(cuid())
  locationId     String
  riskScoreId    String?
  status         AlertStatus @default(OPEN)
  level          RiskLevel
  score          Int
  title          String
  message        String
  recommendedAction String
  priority       AlertPriority @default(P3)
  confidence     Int         @default(50)
  warningLevel   WarningLevel @default(NORMAL)
  triggeredAt    DateTime    @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  riskScore      RiskScore?  @relation(fields: [riskScoreId], references: [id], onDelete: SetNull)
  verifications  FieldVerification[]

  @@index([status, triggeredAt])
  @@index([locationId, status])
}

model FieldVerification {
  id                 String    @id @default(cuid())
  alertId            String
  casesPresent       String
  affectedPeople     Int?
  affectedHouseholds Int?
  symptoms           String[]
  waterSourceId      String?
  waterCondition     String?
  notes              String?
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  verifiedBy         String?
  createdAt          DateTime  @default(now())
  alert              Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}
